{
  "name": "pen-dev-bridge",
  "version": "0.2.0",
  "description": "Session-bound DeepSeek Harness bridge to pen.dev: official Pencil MCP tools, per-conversation headless engines, and an on-demand browser canvas (split or floating, with autosave).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "@pen.dev/cli": "^0.3.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "license": "MIT",
  "private": true
}
